# ============================================================
# Finance AI Trading System - Environment Configuration
# Copy this file to .env: Copy-Item .env.example .env
# ============================================================

# == Dashboard access =========================================
# 127.0.0.1 = only this computer. Use 0.0.0.0 to open the dashboard from your
# phone or other devices at home, and set API_KEY when you do.
HOST=127.0.0.1
PORT=8080
API_KEY=
OPEN_BROWSER=true
# Extra origins allowed to call the API from other web pages (normally leave empty)
CORS_ORIGINS=

# == Signal engine tuning (defaults are sensible) =============
# Round-trip trading cost per market as a fraction (0.002 = 0.20%)
COST_CRYPTO=0.0020
COST_US_STOCKS=0.0005
COST_BR_STOCKS=0.0010
COST_FOREX=0.0003
# News sentiment as a signal input (0 disables it)
SENTIMENT_WEIGHT=1
SENTIMENT_WINDOW_HOURS=6
SENTIMENT_MIN_ARTICLES=2
SENTIMENT_THRESHOLD=0.25
# Live tracking horizons in minutes, and backtest settings
TRACK_HORIZONS_MIN=60,240,1440
BACKTEST_HORIZON_BARS=12
BACKTEST_LOOKBACK_DAYS=90
MIN_SAMPLES_FOR_STATS=20
BACKUP_KEEP=7

# == PostgreSQL (only used by the optional Docker setup) ======
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=finance_ai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# == LLM (Ollama) ============================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.1:8b

# == Open WebUI ===============================================
WEBUI_SECRET_KEY=change-me-to-a-random-secret-key
ENABLE_SIGNUP=false

# == Market Data APIs =========================================
# Binance: Optional, works without keys for public ticker candles
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Alpha Vantage: Optional free key
ALPHA_VANTAGE_API_KEY=

# == Telegram Push Alerts =====================================
# 1. Message @BotFather -> /newbot -> paste token
# 2. Start chat with bot, query https://api.telegram.org/bot<TOKEN>/getUpdates for chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# == Email Push Alerts (Gmail SMTP) ===========================
# Google Account -> Security -> 2FA -> App Passwords
ALERT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
